{
    "name": "@apollohg/react-native-prose-editor",
    "version": "1.0.0-alpha",
    "description": "Native rich text editor with Rust core for React Native",
    "license": "Apache-2.0",
    "homepage": "https://github.com/apollohg/react-native-prose-editor",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apollohg/react-native-prose-editor.git"
    },
    "bugs": {
        "url": "https://github.com/apollohg/react-native-prose-editor/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.js",
    "react-native": "src/index.ts",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./app.plugin": "./app.plugin.js",
        "./app.plugin.js": "./app.plugin.js"
    },
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "benchmark:rust": "./rust/toolchain-cargo.sh bench --manifest-path rust/editor-core/Cargo.toml --bench perf_suite --",
        "benchmark:rust:quick": "./rust/toolchain-cargo.sh bench --manifest-path rust/editor-core/Cargo.toml --bench perf_suite -- --quick",
        "benchmark:rust:yrs": "./rust/toolchain-cargo.sh bench --manifest-path rust/editor-core/Cargo.toml --bench perf_suite -- --filter yrs-foundation",
        "benchmark:rust:yrs:check": "node scripts/check-yrs-document-foundation-benchmarks.mjs --run --baseline rust/editor-core/benches/baselines/yrs-document-foundation.json",
        "benchmark:rust:yrs:editing": "./rust/toolchain-cargo.sh bench --manifest-path rust/editor-core/Cargo.toml --bench perf_suite -- --filter yrs-editing",
        "benchmark:rust:yrs:editing:check": "node scripts/check-yrs-editing-semantics-benchmarks.mjs --run --baseline rust/editor-core/benches/baselines/yrs-editing-semantics.json",
        "benchmark:rust:yrs:quick": "./rust/toolchain-cargo.sh bench --manifest-path rust/editor-core/Cargo.toml --bench perf_suite -- --quick --filter yrs-foundation",
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
        "build:android:example": "npm run prebuild:example:android && cd example/android && ./gradlew app:assembleDebug -x lint -x test --configure-on-demand --build-cache -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a",
        "build:android:library": "npm run prebuild:example:android && cd example/android && ./gradlew :apollohg_react-native-prose-editor:compileDebugKotlin",
        "build:rust": "bash rust/generate-bindings.sh && bash rust/build-ios.sh && bash rust/build-android.sh",
        "build:rust:android": "bash rust/generate-bindings.sh && bash rust/build-android.sh",
        "build:rust:ios": "bash rust/generate-bindings.sh && bash rust/build-ios.sh",
        "install:example:pods": "cd example/ios && pod install --no-repo-update",
        "prebuild:example": "npm --prefix example run prebuild",
        "prebuild:example:android": "npm --prefix example run prebuild:android",
        "prebuild:example:ios": "npm --prefix example run prebuild:ios",
        "prepack": "npm run build",
        "prepare:example:native": "npm run prebuild:example && npm run install:example:pods",
        "prepare:publish": "bash ./scripts/prepare-publish.sh",
        "prepublishOnly": "npm run prepare:publish",
        "run:example:android": "npm --prefix example run android",
        "run:example:ios": "npm --prefix example run ios",
        "start:example": "npm --prefix example start",
        "sync:version": "node scripts/sync-version.mjs",
        "test": "jest --runInBand --watchman=false",
        "test:android": "npm run prebuild:example:android && cd example/android && ./gradlew :apollohg_react-native-prose-editor:testDebugUnitTest",
        "test:android:device": "bash ./scripts/run-android-on-device.sh",
        "test:android:device:ime": "bash ./scripts/run-android-on-device.sh --class com.apollohg.editor.NativeDeviceImeRegressionTest",
        "test:android:device:performance": "bash ./scripts/run-android-on-device.sh --class com.apollohg.editor.NativeDevicePerformanceTest",
        "test:android:performance": "npm run prebuild:example:android && cd example/android && ./gradlew :apollohg_react-native-prose-editor:testDebugUnitTest -PapollohgShowPerfTestOutput=true --tests com.apollohg.editor.NativePerformanceTest",
        "test:ios": "bash ./scripts/run-ios-tests.sh",
        "test:ios:device": "bash ./scripts/run-ios-on-device.sh",
        "test:ios:device:performance": "NATIVE_EDITOR_IOS_TEST_SCHEME=NativeEditorPreparedProsePerformance bash ./scripts/run-ios-on-device.sh -only-testing:NativeEditorTests/NativePerformanceTests/testPerformance_preparedProseCorpusGates_iPhone13",
        "test:ios:performance": "bash ./scripts/run-ios-tests.sh -only-testing:NativeEditorTests/NativePerformanceTests",
        "test:rust": "cargo test --manifest-path rust/editor-core/Cargo.toml",
        "typecheck": "tsc --noEmit",
        "typecheck:example": "npm --prefix example run typecheck",
        "validate:package": "npm run prepare:example:native && node scripts/tests/validate-prepared-prose-viewer-cutover.mjs && npm run validate:security -- --release --behavior && node scripts/tests/validate-security-contracts-negative.mjs && node scripts/tests/validate-publish-lifecycle.mjs && bash ./scripts/tests/validate-generated-bindings.sh && bash ./scripts/tests/validate-packed-xcframework.sh && node scripts/tests/validate-packed-package.test.mjs && bash ./scripts/validate-packed-package.sh",
        "validate:security": "node scripts/tests/validate-security-contracts.mjs",
        "version": "npm run sync:version"
    },
    "peerDependencies": {
        "@expo/vector-icons": ">=14.0.0",
        "expo": ">=52.0.0"
    },
    "codegenConfig": {
        "name": "ReactNativeProseEditorSpec",
        "type": "components",
        "jsSrcsDir": "src/specs",
        "android": {
            "javaPackageName": "com.apollohg.editor.viewer"
        },
        "ios": {
            "componentProvider": {
                "PreparedProseViewer": "PREPPreparedProseViewerComponentView"
            }
        }
    },
    "devDependencies": {
        "@babel/runtime": "^7.29.7",
        "@react-native/jest-preset": "0.86.2",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "29.5.14",
        "@types/react": "^19.2.14",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "prettier": "^3.8.1",
        "react-test-renderer": "19.2.3",
        "typescript": "^5.9.3"
    },
    "files": [
        "README.md",
        "LICENSE",
        "app.plugin.js",
        "dist",
        "src",
        "!src/__tests__",
        "!src/type-tests",
        "android/build.gradle",
        "android/consumer-rules.pro",
        "android/src/main",
        "common/cpp",
        "ios/*.swift",
        "ios/Viewer/**/*",
        "ReactNativeProseEditor.podspec",
        "ios/editor_coreFFI",
        "ios/EditorCore.xcframework",
        "rust/android",
        "rust/bindings/kotlin",
        "expo-module.config.json",
        "react-native.config.js"
    ]
}
