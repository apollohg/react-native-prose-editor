{
  "name": "native-editor-example",
  "version": "1.0.0-alpha",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "preandroid": "npm run prebuild:android",
    "android": "expo run:android --device",
    "preios": "npm run prebuild:ios",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild --clean --no-install",
    "prebuild:android": "expo prebuild --clean --platform android --no-install",
    "prebuild:ios": "expo prebuild --clean --platform ios --no-install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollohg/react-native-prose-editor": "file:..",
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "^57.0.9",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
