{
    "name": "@react-native-rich-text-editor/code-highlighting",
    "version": "2.0.0",
    "description": "Optional native syntax highlighting for react-native-rich-text-editor",
    "license": "Apache-2.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "react-native": "src/index.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "ios",
        "android",
        "!android/build",
        "expo-module.config.json",
        "NativeEditorCodeHighlighting.podspec",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "RUST-STANDARD-LIBRARY-NOTICES.html",
        "scripts/verify-package.mjs"
    ],
    "peerDependencies": {
        "react-native-rich-text-editor": ">=2.0.0 <3",
        "expo": ">=52.0.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test:rust": "cargo test --manifest-path rust/Cargo.toml --release --locked",
        "build:native": "bash scripts/build-native.sh",
        "prepack": "node scripts/verify-package.mjs"
    }
}
